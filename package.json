{
  "name": "arcwiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:sidecar && tauri dev",
    "dev:web": "vite --host localhost --port 1420",
    "build": "bun run build:web",
    "build:web": "tsc --noEmit && vite build",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "desktop:build": "bun run build:sidecar && tauri build",
    "wiki": "bun sidecar/wiki-cli.ts",
    "test": "bun test sidecar src",
    "test:e2e": "bunx tsc --noEmit -p e2e/tsconfig.json && bun scripts/e2e.ts",
    "test:e2e:live": "bunx tsc --noEmit -p e2e/tsconfig.json && bun scripts/e2e.ts --live"
  },
  "dependencies": {
    "@openai/agents": "^0.18.0",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.468.0",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-service": "^1.4.0",
    "@types/bun": "^1.3.0",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "webdriverio": "^9.32.0"
  }
}
