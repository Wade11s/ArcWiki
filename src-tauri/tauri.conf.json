{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcWiki",
  "version": "0.1.0",
  "identifier": "com.wade11s.arcwiki",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArcWiki",
        "width": 1320,
        "height": 840,
        "minWidth": 820,
        "minHeight": 560,
        "backgroundColor": "#ebe7e2",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/arcwiki-sidecar"]
  }
}
